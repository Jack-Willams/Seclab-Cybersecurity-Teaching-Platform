[Unit]
Description=SecLab User Service
After=network.target seclab-mysql.service

[Service]
Type=simple
User=seclab
WorkingDirectory=/opt/seclab/SecLab/seclab-backend
Environment=MYSQL_HOST=127.0.0.1
Environment=MYSQL_PORT=3306
Environment=MYSQL_USER=seclab_app
Environment=MYSQL_PASSWORD=Seclab@123
ExecStart=/bin/bash -lc 'exec java -jar /opt/seclab/SecLab/seclab-backend/user-service/build/libs/*.jar'
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/seclab/logs/user-service.log
StandardError=append:/opt/seclab/logs/user-service.err.log

[Install]
WantedBy=multi-user.target
