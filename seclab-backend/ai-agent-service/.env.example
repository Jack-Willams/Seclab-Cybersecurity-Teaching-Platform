# Direct LLM configuration (OpenAI-compatible endpoint, e.g. DeepSeek).
# Setting LLM_API_KEY makes the assistant and teacher AI analysis call the model
# directly instead of Dify. Set LLM_PROVIDER=dify to fall back to Dify.
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# Dify Agent configuration (used only when LLM_PROVIDER=dify)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=your_dify_api_key_here
DIFY_WORKFLOW_ID=your_dify_workflow_id_here
DIFY_APP_ID=your_dify_app_id_here
ENABLE_FAKE_LLM_FOR_TEST=false

# AI agent service listener
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8010

# Frontend CORS allowlist, comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost,http://192.168.1.106:5173,http://192.168.1.106

# Docker tool container name allowlist, comma-separated prefixes
ALLOWED_CONTAINER_PREFIXES=sqli,xss,csrf,upload,dir,cmd,command,command-inject,sec-code,operation

# Maximum log lines returned by Docker tools
MAX_LOG_LINES=200

# Optional Docker tool API key. Leave empty for local/intranet deployments.
# If enabled, configure Dify tool authentication with the same Bearer token or X-SecLab-Token header.
TOOL_API_KEY=

# MySQL persistence for learning events and profile snapshots
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seclab_app
MYSQL_PASSWORD=Seclab@123
MYSQL_DATABASE=seclab_profile
MYSQL_CHARSET=utf8mb4
